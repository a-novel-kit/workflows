{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gomod": {
    "managerFilePatterns": ["/(^|/)(?:golangci-lint|gotestsum|buf|mockery)\\.mod$/"]
  },
  "packageRules": [
    {
      "matchFileNames": ["golangci-lint.mod"],
      "additionalBranchPrefix": "golangci-lint-",
      "goGetDirs": ["."],
      "postUpgradeTasks": {
        "commands": [
          "rm -f golangci-lint.sum",
          "go get -modfile=golangci-lint.mod -tool github.com/golangci/golangci-lint/v2/cmd/golangci-lint",
          "go tool -modfile=golangci-lint.mod golangci-lint run ./... --fix"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": ["gotestsum.mod"],
      "additionalBranchPrefix": "gotestsum-",
      "goGetDirs": ["."],
      "postUpgradeTasks": {
        "commands": ["rm -f gotestsum.sum", "go get -modfile=gotestsum.mod -tool gotest.tools/gotestsum"],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": ["go.mod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Keep x/tools current for tools that type-check: they read the compiler's export data through it, and a Go patch can raise that format (Go 1.27.2 writes v5, which x/tools before v0.50.0 rejects). Renovate disables the `// indirect` require unless a rule enables it.",
      "matchFileNames": ["golangci-lint.mod", "mockery.mod"],
      "matchDepNames": ["golang.org/x/tools"],
      "enabled": true
    }
  ]
}
