{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["./base"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "postUpdateOptions": ["pnpmDedupe"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "bump",
      "enabled": true
    }
  ]
}
